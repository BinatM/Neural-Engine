    pin(CLKR) {
        is_isolated : true;
        isolation_enable_condition : "SD | SLP";  
        related_power_pin : VDD_i;
        related_ground_pin : VSS;
        direction       : input ;
        capacitance     : 0.0125 ;
        max_transition  : 0.363000 ;
        clock           : "true" ;
        pin_func_type   : active_rising ;

        
        timing () {
            
