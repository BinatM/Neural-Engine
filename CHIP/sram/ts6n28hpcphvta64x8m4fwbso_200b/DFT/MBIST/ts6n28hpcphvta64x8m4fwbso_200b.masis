memory_name = "TS6N28HPCPHVTA64X8M4FWBSO"
masis_version = "masis_1.2"

//This section contains memory general parameters
GeneralParameters {
    PortTypeNum {
        ReadPortNum = 1
        WritePortNum = 1
    }
    MemoryType = "SRAM"
    NumberOfBits = 8
    NumberOfWords = 64
    ReadType = "Synchronous"
    MaxHoldTime =  0.5 
    PowerDissipation = 0.0015
} // end of section GeneralParameters 

Port {
    CLKW {
        Tag = Clock
        Direction = Input
        PortId = "A"
    }
    CLKR {
        Tag = Clock
        Direction = Input
        PortId = "B"
    }
    AA {
        Tag = Address
        Range = "[5:0]"
        Direction = Input
        PortId = "A"
    }
    AB {
        Tag = Address
        Range = "[5:0]"
        Direction = Input
        PortId = "B"
    }
    AMA {
        Tag = TestAddress
        Range = "[5:0]"
        Direction = Input
        PortId = "A"
    }
    AMB {
        Tag = TestAddress
        Range = "[5:0]"
        Direction = Input
        PortId = "B"
    }
    D {
        Tag = Data
        Range = "[7:0]"
        Direction = Input
        PortId = "A"
    }
    DM {
        Tag = TestData
        Range = "[7:0]"
        Direction = Input
        PortId = "A"
    }
    BWEB {
        Tag = WriteEnMask
        Range =  "[7:0]"
        ActiveLevel = False
        Direction = Input
        PortId = "A"
    }    
    BWEBM {
        Tag = TestWriteEnMask
        Range =  "[7:0]"
        ActiveLevel = False
        Direction = Input
        PortId = "A"
    }    
    WEB {
        Tag = WriteEnable
        ActiveLevel = False
        Direction = Input
        PortId = "A"
    } 
    WEBM {
        Tag = TestWriteEnable
        ActiveLevel = False
        Direction = Input
        PortId = "A"
    } 
    REB {
        Tag = ReadEnable
        ActiveLevel = False
        Direction = Input
        PortId = "B"
    } 
    REBM {
        Tag = TestReadEnable
        ActiveLevel = False
        Direction = Input
        PortId = "B"
    } 
    BIST {    
        Tag = BistEn
        Direction = Input
        ActiveLevel = True
    }
    Q {
        Tag = Data
        Range = "[7:0]"
        Direction = Output
        PortId = "B"
    }
    SLP {
        Tag = None      
        Direction = Input
        SafeValue = "1'b0"
        TieLevel =  TestBench
    }    
    SD {
        Tag = None      
        Direction = Input
        SafeValue = "1'b0"
        TieLevel =  TestBench
    }    
}

