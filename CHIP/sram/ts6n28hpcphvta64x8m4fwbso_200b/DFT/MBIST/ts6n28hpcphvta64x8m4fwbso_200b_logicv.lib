MemoryTemplate (TS6N28HPCPHVTA64X8M4FWBSO) {

    CellName        : TS6N28HPCPHVTA64X8M4FWBSO;
    ShadowRead 	    : On;
    ShadowWrite     : On;
    ShadowWriteOK   : On;
    Algorithm       : SMarchCHKBvcd;
    logicalPorts    : 1R1W;
    NumberOfWords   : 64;
    MinHold         : 0.5;
    MilliWattsPerMegaHertz : 0.003;
    TransparentMode : None;  // User options for DFT:
		 	 	    // AsyncMux:    for low speed scan
				    // SyncMux:     for at-speed scan
				    // AsyncWriteThru: if there is AWT in this memory



    Port (SLP)  {
        Function: None ;
	Direction: Input;
        SafeValue:   0;
    }


    Port (SD)  {
        Function: None ;
	Direction: Input;
        SafeValue:   0;
    }


    Port (CLKW)  {
        Function: Clock;
        LogicalPort:	A;
    }
    
    Port (CLKR)  {
        Function: Clock;
        LogicalPort:	B;
    }
    
    Port (REB)  {
        Function: ReadEnable;
        Polarity: ActiveLow;	
        LogicalPort:	B;
        EmbeddedtestLogic {
           Testinput:	REBM;
        }
    }
    
    Port (WEB) {
        Function: WriteEnable; 
        Polarity: ActiveLow;
        LogicalPort:	A;
        EmbeddedtestLogic {
           Testinput:	WEBM;
        }
    }
    
    port (AA[5:0]) {
        function:    address;
        LogicalPort:	A;
        EmbeddedtestLogic {
           Testinput:	AMA[5:0];
        }
    }
    
    port (AB[5:0]) {
        function:    address;
        LogicalPort:	B;
        EmbeddedtestLogic {
           Testinput:	AMB[5:0];
        }
    }
    
    Port (BWEB[7:0]) {
        Function: GroupWriteEnable; 
        LogicalPort:	A;
        Polarity: ActiveLow;
        EmbeddedtestLogic {
           Testinput:	BWEBM[7:0];
        }
    }
    
    Port (D[7:0]) { 
        Function: Data; 
        Direction:   Input;
        LogicalPort:	A;
        EmbeddedtestLogic {
           Testinput:	DM[7:0];
        }
    }
    
    Port (Q[7:0]) { 
        Function: Data; 
        LogicalPort:	B;
        Direction:   Output; 
    }


    Port (BIST)  {
        Function: BistOn ;
	Direction: Input;
    }
	    

    


// 16 rows by 4 columns.
    AddressCounter {
        Function ( ColumnAddress ) {
            LogicalAddressMap {
                ColumnAddress[1:0]:Address[1:0];  // 4 columns
            }
            CountRange [0:3];
        }

	
        Function  ( RowAddress ) {
            LogicalAddressMap {
                RowAddress[3:0]:Address[5:2];  // 16 rows
            }
            CountRange [0:15];
        }
    }
    
 
 
    OperationSet : syncWR;
    bitGrouping : 1;
    
}

